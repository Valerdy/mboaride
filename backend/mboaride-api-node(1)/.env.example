# Copier en .env puis adapter
# Local : PGlite (PostgreSQL embarqué, aucune installation). Production : postgres://user:mdp@hote:5432/mboaride
DATABASE_URL=pglite:./data/mboaride
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=change-me-avec-au-moins-32-caracteres
PORT=8000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
OTP_MINUTES=5
OTP_MAX_ATTEMPTS=5
DEFAULT_COUNTRY_CODE=+237
CORS_ORIGIN=*
RATE_LIMIT_MAX=100

# Itinéraires (OSRM). Local : http://localhost:5000. Dépannage : https://router.project-osrm.org
OSRM_URL=http://localhost:5000
OSRM_TIMEOUT_MS=3000
