# Copié en .env.local par scripts/lancer_tout.ps1 (.env.local n'est jamais commité).
# PostgreSQL installé sur le PC : la base mboaride y est créée au premier lancement.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
# Secret partagé par l'API Node (qui signe les jetons) et l'API Python (qui les vérifie).
# Laisser vide : le script en génère un au premier lancement.
SECRET_KEY=

# Code de vérification (OTP) envoyé par e-mail depuis un compte Gmail.
#  1. Sur le compte Google : Sécurité > Validation en deux étapes (à activer),
#     puis Sécurité > Mots de passe des applications > créer « MboaRide ».
#  2. Mettre ici l'adresse Gmail et le mot de passe de 16 lettres obtenu (pas le mot de passe Gmail).
# Vides : le code reste dans la console de l'API Node et s'affiche dans l'application.
SMTP_USER=
SMTP_PASS=
# email (défaut), sms, ou email+sms
OTP_CHANNEL=email
