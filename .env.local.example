# Copié en .env.local par scripts/lancer_tout.ps1 (.env.local n'est jamais commité).
# PostgreSQL installé sur le PC : la base mboaride y est créée au premier lancement.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
# Secret partagé par l'API Node (qui signe les jetons) et l'API Python (qui les vérifie).
# Laisser vide : le script en génère un au premier lancement.
SECRET_KEY=
